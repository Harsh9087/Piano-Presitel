# Create a NEW server block file for your chosen subdomain.
# Do not replace or edit existing application server blocks.
server {
    listen 80;
    server_name schedule.example.com;

    root /opt/relay-scheduler/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8012;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /django-static/ {
        alias /opt/relay-scheduler/backend/staticfiles/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
